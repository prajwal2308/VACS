#!/usr/bin/env bash
# Strips Cursor agent co-author trailers before commit is finalized.
# Install: ./scripts/install-git-hooks.sh
set -euo pipefail
MSG_FILE="${1:?}"
case "${2:-}" in
  merge|squash) exit 0 ;;
esac
if [[ ! -f "$MSG_FILE" ]]; then exit 0; fi
tmp="$(mktemp)"
grep -v '^Co-authored-by: Cursor <cursoragent@cursor.com>$' "$MSG_FILE" > "$tmp" || true
mv "$tmp" "$MSG_FILE"
